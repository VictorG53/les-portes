# Copier en .env et renseigner de vraies valeurs avant `docker compose up`.

# Mot de passe de la base Postgres (choisir une valeur aléatoire, ex. `openssl rand -hex 24`)
POSTGRES_PASSWORD=change-me

# Secret de signature des JWT (aléatoire, ex. `openssl rand -hex 32`) : ne jamais réutiliser d'un autre projet
JWT_SECRET=change-me

# Origine(s) du frontend autorisée(s) pour les requêtes authentifiées, séparées par des virgules.
# Ex. : https://les-portes.fwszs.dev,http://localhost:5173
CORS_ORIGIN=
